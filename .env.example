# =============================================
# AIRCTT Environment Variables
# =============================================
# Supabase 연결 (필수!)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...YOUR_ANON_KEY

# PostgREST 직접 연결 (선택, 미설정 시 위 값 사용)
# POSTGREST_URL=https://YOUR_PROJECT.supabase.co/rest/v1
# POSTGREST_API_KEY=eyJhbGci...YOUR_ANON_KEY

# Supabase 기능 활성화
NEXT_PUBLIC_ENABLE_SUPABASE=true

# Zoer AI (선택)
# NEXT_PUBLIC_ZOER_HOST=https://zoer.ai

# Toss Payments (선택)
# NEXT_PUBLIC_TOSS_CLIENT_KEY=
# TOSS_SECRET_KEY=
